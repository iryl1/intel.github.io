<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Loader</title>
</head>
<body>
<script>
(function() {
    // Decodes and dynamically renders the packed HTML content
    const payload = "";
    const decoded = decodeURIComponent(escape(atob(payload)));
    document.open();
    document.write(decoded);
    document.close();
})();
</script>
</body>
</html>
