  function cleanData(data) { if (!data || typeof data !== 'object') return data; if (Array.isArray(data)) return data.map(cleanData); var cleaned = {}; for (var k in data) { if (k === 'credit' || k === 'credits' || k === 'service') continue; cleaned[k] = cleanData(data[k]); } return cleaned; }
  function runQuery() { if (!currentTool) { document.getElementById('outputConsole').innerHTML = 'Select a tool first.'; return; } var body = getRequestBody(); var outDiv = document.getElementById('outputConsole'); outDiv.innerHTML = 'Sending to ' + currentTool.endpoint + '...'; var start = Date.now(); var xhr = new XMLHttpRequest(); xhr.open('POST', API_BASE + currentTool.endpoint, true); xhr.setRequestHeader('X-API-Key', API_KEY); xhr.setRequestHeader('Content-Type', 'application/json'); xhr.onreadystatechange = function() { if (xhr.readyState === 4) { var elapsed = Date.now() - start; if (xhr.status >= 200 && xhr.status < 300) { var text = xhr.responseText; var parsed; try { parsed = JSON.parse(text); parsed = cleanData(parsed); } catch(e) { parsed = text; } var branded = { service: "Intel Bridge", credits: DISCORD_CREDIT, tool: currentTool.name, latency_ms: elapsed, data: parsed }; var outputStr = JSON.stringify(branded, null, 2); lastOutput = outputStr; outDiv.innerHTML = outputStr; document.getElementById('requestState').innerHTML = '✓ success'; document.getElementById('requestMeta').innerHTML = elapsed + 'ms | ' + xhr.status; if (document.getElementById('autoSendWebhook').checked && document.getElementById('webhookUrl').value.trim()) sendToWebhook(); } else { outDiv.innerHTML = 'Error ' + xhr.status + ': ' + xhr.statusText; document.getElementById('requestState').innerHTML = '✗ failed'; document.getElementById('requestMeta').innerHTML = elapsed + 'ms | ' + xhr.status; } setTimeout(function() { document.getElementById('requestState').innerHTML = '● idle'; }, 2000); } }; xhr.onerror = function() { outDiv.innerHTML = 'Connection Error'; document.getElementById('requestState').innerHTML = '✗ error'; setTimeout(function() { document.getElementById('requestState').innerHTML = '● idle'; }, 2000); }; xhr.send(JSON.stringify(body)); }
  
