  function getAllEndpoints() {
    var endpoints = {};
    for (var i = 0; i < categories.length; i++) {
      for (var j = 0; j < categories[i].tools.length; j++) {
        endpoints[categories[i].tools[j].endpoint] = true;
      }
    }
    return Object.keys(endpoints);
  }
  
  function checkEndpointStatus(endpoint) {
    return new Promise(function(resolve) {
      var start = Date.now();
      var testData = getTestDataForEndpoint(endpoint);
      var xhr = new XMLHttpRequest();
      xhr.open('POST', API_BASE + endpoint, true);
      xhr.setRequestHeader('X-API-Key', API_KEY);
      xhr.setRequestHeader('Content-Type', 'application/json');
      xhr.timeout = 8000;
      xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
          var elapsed = Date.now() - start;
          var isOnline = (xhr.status >= 200 && xhr.status < 500) && xhr.status !== 404;
          resolve({ endpoint: endpoint, online: isOnline, status: xhr.status, latency: elapsed });
        }
      };
      xhr.onerror = function() { resolve({ endpoint: endpoint, online: false, status: 0, latency: 0 }); };
      xhr.ontimeout = function() { resolve({ endpoint: endpoint, online: false, status: 0, latency: 0 }); };
      xhr.send(JSON.stringify(testData));
    });
  }
  
  async function refreshAllEndpoints() {
    var grid = document.getElementById('statusGrid');
    if (!grid) return;
    grid.innerHTML = '<div class="loading-spinner-overlay"><div class="loading-spinner"></div><div>Checking endpoint statuses...</div></div>';
    var endpoints = getAllEndpoints();
    var results = [];
    for (var i = 0; i < endpoints.length; i++) {
      var result = await checkEndpointStatus(endpoints[i]);
      results.push(result);
      renderStatusGrid(results);
    }
  }
  
  function renderStatusGrid(results) {
    var grid = document.getElementById('statusGrid');
    var statsDiv = document.getElementById('statusStats');
    if (!grid) return;
    var onlineCount = 0;
    for (var i = 0; i < results.length; i++) { if (results[i].online) onlineCount++; }
    if (statsDiv) {
      statsDiv.innerHTML = '<div class="stat-card"><div class="stat-number">' + onlineCount + '</div><div class="stat-label">Online</div></div><div class="stat-card"><div class="stat-number">' + (results.length - onlineCount) + '</div><div class="stat-label">Offline</div></div><div class="stat-card"><div class="stat-number">' + results.length + '</div><div class="stat-label">Total</div></div>';
    }
    var html = '';
    for (var i = 0; i < results.length; i++) {
      var r = results[i];
      var statusClass = r.online ? 'status-online' : 'status-offline';
      var statusText = r.online ? 'Online' : 'Offline';
      var detail = r.online ? (r.latency + 'ms - HTTP ' + r.status) : (r.status ? 'HTTP ' + r.status : 'No response');
      html += '<div class="status-item"><span><strong>' + r.endpoint + '</strong><br><span style="font-size:0.65rem;">' + detail + '</span></span><span class="' + statusClass + '">' + statusText + '</span></div>';
    }
    grid.innerHTML = html;
  }
  
