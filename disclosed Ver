        var html = '<select id="param_' + f.key + '">';
        for (var o = 0; o < f.options.length; o++) html += '<option value="' + f.options[o].v + '">' + f.options[o].l + '</option>';
        html += '</select>';
        div.innerHTML += html;
      } else if (f.type === 'textarea') {
        div.innerHTML += '<textarea id="param_' + f.key + '" placeholder="' + (f.placeholder || '') + '" rows="3"></textarea>';
      } else {
        div.innerHTML += '<input type="text" id="param_' + f.key + '" placeholder="' + (f.placeholder || '') + '">';
