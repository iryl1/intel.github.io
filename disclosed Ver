  /* Navigation - Dark Mode Support */
  .navbar {
    background: rgba(255,255,255,0.98);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #e2e8f0;
    padding: 16px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  body.dark-mode .navbar {
    background: rgba(2,6,23,0.98);
    border-bottom-color: #1e293b;
  }
  .logo { font-size: 1.5rem; font-weight: 800; background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nav-links { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
  .nav-link { color: #475569; font-weight: 500; font-size: 0.875rem; cursor: pointer; transition: color 0.2s; }
  body.dark-mode .nav-link { color: #94a3b8; }
  .nav-link:hover { color: #10b981; }
  
  .user-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #f1f5f9;
    padding: 6px 16px 6px 20px;
    border-radius: 100px;
  }
  body.dark-mode .user-controls { background: #1e293b; }
  .user-name { font-weight: 600; font-size: 0.875rem; }
  .user-plan { font-size: 0.7rem; padding: 2px 10px; border-radius: 100px; background: rgba(16,185,129,0.15); color: #10b981; }
  
  .btn-outline { background: transparent; border: 1.5px solid #10b981; padding: 8px 20px; border-radius: 40px; color: #10b981; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
  .btn-outline:hover { background: #10b981; color: white; transform: translateY(-1px); }
  .btn-primary { background: #10b981; border: none; padding: 8px 20px; border-radius: 40px; color: white; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
  .btn-primary:hover { background: #059669; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(16,185,129,0.3); }
  .btn-large { padding: 12px 32px; font-size: 1rem; border-radius: 48px; }
  .theme-toggle { background: #f1f5f9; border: none; padding: 8px 12px; border-radius: 40px; cursor: pointer; font-size: 1rem; transition: all 0.2s; }
  body.dark-mode .theme-toggle { background: #1e293b; color: #f1f5f9; }

  .page { display: none; }
  .page.active { display: block; animation: fadeIn 0.4s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .container { max-width: 1280px; margin: 0 auto; padding: 48px 32px; }

  .hero { text-align: center; padding: 64px 32px; max-width: 800px; margin: 0 auto; }
  .hero h1 { font-size: 3.5rem; font-weight: 800; margin-bottom: 24px; background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero p { font-size: 1.125rem; color: #64748b; max-width: 600px; margin: 0 auto 32px; }
  body.dark-mode .hero p { color: #94a3b8; }
  .cta-buttons { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  .features-grid { display: flex; flex-wrap: wrap; gap: 32px; justify-content: center; margin-top: 48px; }
  .feature-card { background: white; border: 1px solid #e2e8f0; border-radius: 24px; padding: 32px; width: 280px; text-align: center; transition: all 0.3s; }
  body.dark-mode .feature-card { background: #0f172a; border-color: #1e293b; }
  .feature-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); }
  .feature-icon { margin-bottom: 16px; }

  .pricing-grid { display: flex; flex-wrap: wrap; gap: 32px; justify-content: center; margin-top: 48px; }
  .pricing-card { background: white; border: 1px solid #e2e8f0; border-radius: 32px; padding: 32px; width: 320px; position: relative; transition: all 0.3s; }
  body.dark-mode .pricing-card { background: #0f172a; border-color: #1e293b; }
  .pricing-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
  .pricing-card.popular { border: 2px solid #10b981; }
  .popular-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #10b981; color: white; padding: 4px 16px; border-radius: 40px; font-size: 0.7rem; font-weight: 600; }
  .plan-name { font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; }
  .plan-price { font-size: 2.5rem; font-weight: 800; margin-bottom: 16px; }
  .plan-price span { font-size: 0.9rem; font-weight: 400; color: #64748b; }
  body.dark-mode .plan-price span { color: #94a3b8; }
  .plan-features { list-style: none; margin: 24px 0; }
  .plan-features li { padding: 8px 0; font-size: 0.875rem; display: flex; align-items: center; gap: 8px; }
  .plan-features li::before { content: "✓"; color: #10b981; font-weight: bold; }

  .auth-container { max-width: 440px; margin: 60px auto; background: white; border: 1px solid #e2e8f0; border-radius: 32px; padding: 40px; }
  body.dark-mode .auth-container { background: #0f172a; border-color: #1e293b; }
  .auth-tabs { display: flex; gap: 24px; margin-bottom: 32px; border-bottom: 1px solid #e2e8f0; }
  body.dark-mode .auth-tabs { border-bottom-color: #1e293b; }
  .auth-tab { padding: 8px 0; cursor: pointer; font-weight: 600; font-size: 1rem; border-bottom: 2px solid transparent; }
  .auth-tab.active { border-bottom-color: #10b981; color: #10b981; }
  .auth-form { display: none; }
  .auth-form.active { display: block; }
  .input-group { margin-bottom: 20px; }
  .input-group label { display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 6px; }
  body.dark-mode .input-group label { color: #94a3b8; }
  .input-group input { width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 16px; background: #f8fafc; font-size: 0.875rem; }
  body.dark-mode .input-group input { background: #1e293b; border-color: #334155; color: #f1f5f9; }
  .input-group input:focus { outline: none; border-color: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.1); }
  .error-msg { color: #ef4444; font-size: 0.75rem; margin-top: 12px; text-align: center; }

  .payment-container { max-width: 500px; margin: 60px auto; background: white; border: 1px solid #e2e8f0; border-radius: 32px; padding: 40px; text-align: center; }
  body.dark-mode .payment-container { background: #0f172a; border-color: #1e293b; }
  .payment-amount { font-size: 3rem; font-weight: 800; color: #10b981; margin: 16px 0; }
  .card-element { border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px; margin: 24px 0; background: #f8fafc; }
  body.dark-mode .card-element { background: #1e293b; border-color: #334155; }

  /* Status Page - Full Dark Mode */
  .status-stats-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
  .status-stats { display: flex; gap: 16px; }
  .stat-card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px 24px; text-align: center; transition: all 0.2s; }
  body.dark-mode .stat-card { background: #0f172a !important; border-color: #1e293b !important; }
  .stat-number { font-size: 2rem; font-weight: 800; }
  .stat-label { font-size: 0.7rem; color: #64748b; }
  body.dark-mode .stat-label { color: #94a3b8; }
  .status-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; max-height: 500px; overflow-y: auto; }
  .status-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; transition: all 0.2s; }
  body.dark-mode .status-item { background: #0f172a !important; border-color: #1e293b !important; }
  .status-online { color: #10b981; font-weight: 600; }
  .status-offline { color: #ef4444; font-weight: 600; }
  .loading-spinner-overlay { text-align: center; padding: 40px; }
  .loading-spinner { width: 40px; height: 40px; border: 3px solid #e2e8f0; border-top-color: #10b981; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
  body.dark-mode .loading-spinner { border-color: #1e293b; border-top-color: #10b981; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .status-refresh { background: #10b981; color: white; border: none; padding: 8px 20px; border-radius: 40px; cursor: pointer; transition: all 0.2s; }
  .status-refresh:hover { transform: scale(1.02); background: #059669; }

  /* Tools Interface - Full Dark Mode */
  .tools-container { max-width: 1400px; margin: 0 auto; padding: 32px; }
  .tools-header { margin-bottom: 32px; }
  .tools-header h2 { font-size: 1.75rem; font-weight: 700; margin-bottom: 8px; }
  .category-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px; }
  body.dark-mode .category-tabs { border-bottom-color: #1e293b; }
  .category-tab { padding: 10px 20px; cursor: pointer; font-size: 0.85rem; font-weight: 500; color: #64748b; border-radius: 40px; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
  body.dark-mode .category-tab { color: #94a3b8; }
  .category-tab:hover { background: rgba(16,185,129,0.1); color: #10b981; }
  .category-tab.active { background: #10b981; color: white; }
  .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 32px; }
  .tool-card { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px 20px; cursor: pointer; transition: all 0.2s; display: flex; justify-content: space-between; align-items: center; }
  body.dark-mode .tool-card { background: #0f172a; border-color: #1e293b; }
  .tool-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); border-color: #10b981; }
  .tool-card.active { background: rgba(16,185,129,0.08); border-color: #10b981; border-left: 3px solid #10b981; }
  .tool-card-info { display: flex; flex-direction: column; gap: 4px; }
  .tool-card-name { font-weight: 600; font-size: 0.9rem; }
  .tool-card-endpoint { font-family: monospace; font-size: 0.65rem; color: #64748b; }
  body.dark-mode .tool-card-endpoint { color: #94a3b8; }
  .tool-card-icon { width: 32px; height: 32px; background: rgba(16,185,129,0.1); border-radius: 10px; display: flex; align-items: center; justify-content: center; }

  .query-panel { background: white; border: 1px solid #e2e8f0; border-radius: 24px; padding: 24px; margin-top: 32px; }
  body.dark-mode .query-panel { background: #0f172a; border-color: #1e293b; }
  .query-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
  .query-input { flex: 1; padding: 14px 18px; border: 1px solid #e2e8f0; border-radius: 16px; background: #f8fafc; font-size: 0.875rem; }
